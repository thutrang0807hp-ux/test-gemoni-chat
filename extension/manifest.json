{
  "manifest_version": 3,
  "name": "Studio Ảnh Gemini",
  "description": "Gửi prompt từ Gemini Studio và trả kết quả từ tab Gemini Chat.",
  "version": "0.2.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://thutrang0807hp-ux.github.io/test-gemoni-chat/*"
      ],
      "js": [
        "studio.js"
      ],
      "run_at": "document_start"
    }
  ]
}
